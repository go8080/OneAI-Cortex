# ============================================================
# OneAI-Cortex Environment Configuration
# ============================================================
# IMPORTANT: This .env file is SHARED between OneAI-Auth and
# OneAI-Cortex via Docker Compose env_file directive.
# ============================================================

# === SHARED between OneAI-Auth and OneAI-Cortex (MUST match) ===
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# === Cortex Encryption ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP — losing this key makes all encrypted secrets unrecoverable
ENCRYPTION_KEY=

# === Database ===
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === OneAI-Auth Service (HARD DEPENDENCY) ===
AUTH_SERVICE_URL=http://localhost:8001

# === Agent Execution ===
AGENT_EXECUTION_TIMEOUT_SECONDS=120

# === Checkpointing ===
CHECKPOINT_DIR=data/checkpoints
CHECKPOINT_RETENTION_DAYS=7

# === Telemetry ===
OTLP_ENDPOINT=http://localhost:4317
ENVIRONMENT=development
LOG_LEVEL=INFO
